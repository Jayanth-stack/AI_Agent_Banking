# Required for discovery (the LLM-driven run). Replay does not need a model.
# Gemini is the default when GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional override: gemini | openai
# LLM_PROVIDER=gemini

# Fallback if you don't have Gemini.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Target + operator
TARGET_PORT=3847
OPERATOR_PORT=3848
TARGET_URL=http://127.0.0.1:3847
