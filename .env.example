# Required for discovery (the LLM-driven run). Replay does not need a model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional. If set, discovery uses Anthropic instead.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Target + operator
TARGET_PORT=3847
OPERATOR_PORT=3848
TARGET_URL=http://127.0.0.1:3847
